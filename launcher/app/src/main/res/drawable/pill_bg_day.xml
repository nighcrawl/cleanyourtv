<?xml version="1.0" encoding="utf-8"?>
<!-- pill_bg for Home by day (auto_theme): frosted white on the light background, ink when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F21A2030" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF3B8FD9" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#B8FFFFFF" android:endColor="#73FFFFFF" />
            <stroke android:width="1dp" android:color="#99FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
