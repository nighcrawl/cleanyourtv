<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="tv.reprendre">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="30"/>
  <uses-permission android:name="android.permission.READ_TV_LISTINGS"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <queries>
    <package android:name="com.amazon.amazonvideo.livingroom"/>
    <package android:name="com.disney.disneyplus"/>
    <package android:name="com.canal.android.canal"/>
    <package android:name="com.netflix.ninja"/>
    <package android:name="org.jellyfin.androidtv"/>
  </queries>
  <application android:label="Reprendre" android:usesCleartextTraffic="false">
    <provider android:name=".ItemsProvider" android:authorities="tv.reprendre.items" android:exported="true"/>
    <activity android:name=".MainActivity" android:exported="true" android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent-filter>
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="com.gathin.tvhome.category.DOCK_CARD"/></intent-filter>
      <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card"/>
    </activity>
  </application>
</manifest>
